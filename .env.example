AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Seeds a fixed SimpleAuthManager login with the Admin role, stable across
# redeploys. If left unset, Airflow auto-generates a random "admin" password
# on first boot and logs it once to stdout.
_AIRFLOW_WWW_USER_USERNAME=admin
# Set this in the Railway dashboard as a generated secret
_AIRFLOW_WWW_USER_PASSWORD=
